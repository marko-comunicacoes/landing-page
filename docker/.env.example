# Copie para docker/.env e ajuste. Esse arquivo não vai para o Git.

# Admin (/admin e /guia). Sem senha, o admin fica desativado.
ADMIN_USER=marko
ADMIN_PASSWORD=

# Porta interna do container (a porta do host fica no compose.yaml: HOST_PORT, padrão 8090)
PORT=3000

# Pasta dos dados dentro do container (volume ./data)
DATA_DIR=/data

# true quando estiver atrás de um proxy reverso (Nginx, Caddy, Traefik) que envia X-Forwarded-For
TRUST_PROXY=false

# Tamanho máximo dos envios do admin, em MB
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_VIDEO_MB=60

# Quantas versões anteriores da configuração guardar em data/historico/
CONFIG_HISTORY=30

# Opcional: URL que recebe um POST JSON a cada pedido de orçamento (n8n, Make, Zapier...)
CONTATO_WEBHOOK_URL=
